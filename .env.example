# Supabase project URL and publishable (anon) key. Never put service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by verified payment webhooks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Future payment adapters (optional; checkout stays disabled until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOLLIE_API_KEY=
